{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiscuitsFocusStructuredOutput",
  "description": "Structured output schema for Biscuits Focus. Only used when the router selects 'structured' mode; free conversation responses are plain text and are NOT validated against this schema.",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["task_breakdown", "next_action", "prioritization", "overwhelm", "energy", "resume", "capture", "safety_redirect"]
    },
    "energy": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "summary": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "duration_minutes": { "type": "integer", "minimum": 0 },
        "difficulty": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["title"]
    },
    "tasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_clarification": {
      "type": "boolean"
    }
  },
  "required": ["intent"],
  "additionalProperties": false
}
