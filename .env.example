# Biscuits Focus - local configuration.
# Copy to .env (setup.ps1 / setup-linux.sh do it for you). .env is git-ignored: never commit it.
# Variables already set in the shell take precedence over this file.
# Read by the API (api/__init__.py) and by start.ps1 / start.sh.

# --- Authentication -----------------------------------------------------------
# login : local accounts + sessions (default). On first launch the console shows a
#         screen to create the admin (only from the machine running the API); more
#         accounts and roles are managed in the console, page "Utilisateurs".
# local : no auth, every caller is admin (single-user dev only, API bound to 127.0.0.1)
# proxy : identity injected by a trusted reverse proxy (needs BISCUITS_PROXY_SECRET)
BISCUITS_AUTH_MODE=login
# BISCUITS_PROXY_SECRET=change-me-long-random-string
# BISCUITS_SESSION_TTL_SECONDS=43200

# First admin account for a fresh "login" deployment (created once, only if no user exists).
# BISCUITS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BISCUITS_BOOTSTRAP_ADMIN_PASSWORD=
# BISCUITS_BOOTSTRAP_ADMIN_NAME=Administrateur

# --- Storage -------------------------------------------------------------------
# Control-plane SQLite DB (users, conversations, budgets, audit). Default: .enterprise/control-plane.db
# BISCUITS_ENTERPRISE_DB=
# Job history directory. Default: .jobs/
# BISCUITS_JOBS_DIR=

# --- Outbound network ------------------------------------------------------------
# Full-local guarantee (default): 1 = the API refuses every outbound call (external AI
# providers, MCP servers, project tools) except allowlisted loopback services (local
# Ollama), and puts HuggingFace/transformers/datasets offline + disables their telemetry.
# Set here, it is locked on: the console toggle cannot turn it off.
# Models must already be in the HF cache — the setup scripts pre-download the RAG
# embedding model. To download a new base model: set 0, restart, download, set back to 1.
BISCUITS_OFFLINE=1
# Private host:port pairs that project tools/providers/MCP servers may call.
# BISCUITS_OUTBOUND_ALLOW_PRIVATE=127.0.0.1:11434,localhost:11434

# --- Privacy: disable third-party telemetry --------------------------------------
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=False
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

